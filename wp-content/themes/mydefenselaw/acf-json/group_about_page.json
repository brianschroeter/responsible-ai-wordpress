                    "wrapper": {
                        "width": "30",
                        "class": "",
                        "id": ""
                    }
                },
                {
                    "key": "field_principle_description",
                    "label": "Description",
                    "name": "principle_description",
                    "type": "text",
                    "instructions": "Description text after the dash",
                    "wrapper": {
                        "width": "70",
                        "class": "",
                        "id": ""
                    }
                }
            ]
        },
        {
            "key": "field_about_tab_attorneys",
            "label": "Meet The Attorneys",
