            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            }
        },
        {
            "key": "field_about_attorneys_display_mode",
            "label": "Display Mode",
            "name": "about_attorneys_display_mode",
            "type": "select",
            "instructions": "Choose how to select attorneys for display",
            "choices": {
                "all": "Show All Attorneys",
                "select": "Select Specific Attorneys",
                "limit": "Show Latest (Limited)"
            },
            "default_value": "all",
            "return_format": "value",
            "wrapper": {
                "width": "50",
                "class": "",
                "id": ""
            }
        },
        {
            "key": "field_about_attorneys_limit",
            "label": "Number to Display",
            "name": "about_attorneys_limit",
            "type": "number",
            "instructions": "Maximum attorneys to display",
            "conditional_logic": [
                [
                    {
                        "field": "field_about_attorneys_display_mode",
                        "operator": "==",
                        "value": "limit"
                    }
                ]
            ],
            "default_value": 3,
            "min": 1,
            "max": 10,
            "wrapper": {
                "width": "50",
                "class": "",
                "id": ""
            }
        },
        {
            "key": "field_about_attorneys_selected",
            "label": "Select Attorneys",
            "name": "about_attorneys_selected",
            "type": "relationship",
            "instructions": "Choose specific attorneys to display",
            "conditional_logic": [
                [
                    {
                        "field": "field_about_attorneys_display_mode",
                        "operator": "==",
                        "value": "select"
                    }
                ]
            ],
            "post_type": [
                "attorney"
            ],
            "filters": [
                "search"
            ],
            "return_format": "object",
            "min": 0,
            "max": 10,
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            }
        },
