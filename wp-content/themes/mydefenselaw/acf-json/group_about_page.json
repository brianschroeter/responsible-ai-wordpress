            "type": "textarea",
            "instructions": "Introductory paragraph before the mission principles list",
            "rows": 3,
            "default_value": "Defense Lawyers, P.A. is committed to providing the absolute highest quality of legal advice and advocacy. We recognize that our success must be earned every day to maintain the firm and long standing relationships that we enjoy with our clients. To achieve this end, our firm is committed to the following principles:",
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            }
        },
        {
            "key": "field_about_mission_principles",
            "label": "Mission Principles",
            "name": "about_mission_principles",
            "type": "repeater",
            "instructions": "Core principles displayed as bullet points",
            "min": 1,
            "max": 10,
            "layout": "table",
            "button_label": "Add Principle",
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "sub_fields": [
                {
                    "key": "field_principle_title",
                    "label": "Title",
